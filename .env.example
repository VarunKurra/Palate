# Server-only configuration for Supabase Edge Functions. Never expose these in frontend code.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ALLOWED_ORIGINS=http://127.0.0.1:8942,http://localhost:8942
# Auth email sending uses Supabase Dashboard → Authentication → Email → SMTP settings.
# Configure host, port, username, password, sender name and a verified sender domain there.
